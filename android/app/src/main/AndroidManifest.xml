<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 푸시 · 실천 도우미 알림 (Android 13+ 는 사용자 허락 필요) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 설정 > 외부 캘린더 가져오기 (휴대폰 캘린더 읽기) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <queries>
        <!-- 카카오톡으로 로그인할 수 있는지 확인 -->
        <package android:name="com.kakao.talk" />
    </queries>

    <application
        android:name=".NaleulApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Naleul"
        android:usesCleartextTraffic="${usesCleartextTraffic}">

        <!--
            configChanges: 화면 회전 · 다크 모드 전환 때 Activity 를 다시 만들지 않아요.
            화면 상태를 remember 로 들고 있어서(iOS @State 처럼), 다시 만들면 입력하던 내용이 사라져요.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density|fontScale|locale|layoutDirection"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Naleul"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 카카오 로그인이 끝나면 앱으로 돌아오는 통로 -->
        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:host="oauth" android:scheme="kakao${KAKAO_APP_KEY}" />
            </intent-filter>
        </activity>

        <!-- FCM 푸시 수신 -->
        <service
            android:name=".feature.notifications.NaleulFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 예약해 둔 실천 도우미 알림을 띄우는 수신기 -->
        <receiver
            android:name=".feature.notifications.NudgeAlarmReceiver"
            android:exported="false" />

        <!-- Google AdMob 앱 ID (build.gradle.kts 의 ADMOB_APP_ID — 비어 있으면 구글 테스트 앱 ID) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${ADMOB_APP_ID}" />

        <!-- 시스템이 대신 표시하는 알림이 쓸 기본 채널과 아이콘 -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="naleul_default" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

    </application>

</manifest>
